# Copia a .env y rellena los valores. No commitees .env.

# Google OAuth (opcional). Registra esta URL exacta en Google Cloud Console:
# GOOGLE_CALLBACK_URL → ej. http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Origen del SPA (redirecciones tras login con Google; HashRouter → /#/auth)
FRONTEND_URL=http://localhost:8080
